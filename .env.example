APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8080
DATABASE_URL=postgres://my_tashabbus:my_tashabbus_password@postgres:5432/my_tashabbus?sslmode=disable
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
JWT_SECRET=dev-secret-change-me
JWT_ACCESS_TOKEN_TTL_MINUTES=1440
TELEGRAM_AUTH_DEV_MODE=true
TELEGRAM_BOT_TOKEN=
# Legacy fallback only. Prefer TELEGRAM_BOT_TOKEN for new setups.
BOT_TOKEN=
APP_MFY_NAME=My Tashabbus MFY
APP_MFY_SLUG=my-tashabbus-mfy
# Preferred chairman/owner env for this single-MFY deployment.
MFY_CHAIRMAN_TELEGRAM_ID=
# Legacy alias, supported for local setups that already use ADMIN_TELEGRAM_ID.
ADMIN_TELEGRAM_ID=
# Legacy fallback. Prefer MFY_CHAIRMAN_TELEGRAM_ID.
MFY_OWNER_TELEGRAM_ID=

POSTGRES_USER=my_tashabbus
POSTGRES_PASSWORD=my_tashabbus_password
POSTGRES_DB=my_tashabbus

BOT_ENV=development
API_BASE_URL=http://api:8080
MINI_APP_URL=http://localhost:5174

VITE_API_BASE_URL=http://localhost:8080
VITE_ALLOWED_HOSTS=
